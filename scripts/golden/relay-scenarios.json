  {
   "id": "failures",
   "description": "The orchestrator catches a hung worker, a garbled reply, a writer that claims checks it never ran, and survives its own session ending with work still open.",
   "steps": [
    {
     "name": "orchestrator begins",
     "do": "runtime",
     "args": [
      "begin",
      "--session",
      "orch"
     ]
    },
    {
     "name": "plan records the phase",
     "do": "runtime",
     "args": [
      "plan",
      "--session",
      "orch",
      "--expect-revision",
      "{rev}",
      "--input",
      "{packets}/plan.json"
     ],
     "files": {
      "plan.json": {
       "phases": [
        {
         "id": "P1",
         "title": "Greeting",
         "acceptance": "greeting.txt says hello",
         "paths": [
          "greeting.txt"
         ],
         "required_checks": [
          "unit"
         ]
        },
        {
         "id": "P2",
         "title": "Slow",
         "acceptance": "slow.txt exists",
         "paths": [
          "slow.txt"
         ],
         "required_checks": [
          "unit"
         ]
        }
       ]
      }
     }
    },
    {
     "name": "consult packet",
     "do": "packet",
     "file": "consult.md",
     "header": {
      "mode": "consult",
      "name": "hang-1",
      "orchestrator": "orch",
      "workspace": "{root}"
     },
     "body": "Anything."
    },
    {
     "name": "a hanging worker is started with a timeout",
     "do": "runtime",
     "args": [
      "delegate",
      "start",
      "--session",
      "orch",
      "--expect-revision",
      "{rev}",
      "--name",
      "hang-1",
      "--provider",
      "stub",
      "--mode",
      "consult",
      "--packet",
      "{packets}/consult.md",
      "--timeout",
      "5",
      "--",
      "{python}",
      "{stub}",
      "{packet}",
      "--behavior",
      "hang"
     ]
    },
    {
     "name": "a reply for it arrives early",
     "do": "reply",
     "file": "early.txt",
     "result": {
      "outcome": "completed",
      "summary": "early",
      "answer": "x"
     }
    },
    {
     "name": "collect --from is refused while the worker still runs",
     "do": "runtime",
     "args": [
      "delegate",
      "collect",
      "--session",
      "orch",
      "--name",
      "hang-1",
      "--from",
      "{packets}/early.txt"
     ],
     "expect": [
      {
       "path": "ok",
       "equals": false
      },
      {
       "path": "error.code",
       "equals": "delegation_running"
      }
     ]
    },
    {
     "name": "the supervisor stops it at the timeout",
     "do": "wait",
     "delegation": "hang-1",
     "expect": [
      {
       "path": "status",
       "equals": "exited"
      },
      {
       "path": "runtime.timed_out",
       "equals": true
      }
     ]
    },
    {
     "name": "collect finds no result",
     "do": "runtime",
     "args": [
      "delegate",
      "collect",
      "--session",
      "orch",
      "--name",
      "hang-1"
     ],
     "expect": [
      {
       "path": "result.status",
       "equals": "malformed"
      }
     ]
    },
    {
     "name": "cancel closes it",
     "do": "runtime",
     "args": [
      "delegate",
      "cancel",
      "--session",
      "orch",
      "--name",
      "hang-1"
     ],
     "expect": [
      {
       "path": "result.status",
       "equals": "cancelled"
      }
     ]
    },
    {
     "name": "a garbling worker is started",
     "do": "runtime",
     "args": [
      "delegate",
      "start",
      "--session",
      "orch",
      "--expect-revision",
      "{rev}",
      "--name",
      "garble-1",
      "--provider",
      "stub",
      "--mode",
      "consult",
      "--packet",
      "{packets}/consult.md",
      "--",
      "{python}",
      "{stub}",
      "{packet}",
      "--behavior",
      "garbage"
     ]
    },
    {
     "name": "it exits",
     "do": "wait",
     "delegation": "garble-1",
     "expect": [
      {
       "path": "status",
       "equals": "exited"
      }
     ]
    },
    {
     "name": "its reply is reported as malformed, not accepted",
     "do": "runtime",
     "args": [
      "delegate",
      "collect",
      "--session",
      "orch",
      "--name",
      "garble-1"
     ],
     "expect": [
      {
       "path": "result.status",
       "equals": "malformed"
      },
      {
       "path": "result.error",
       "contains": "RELAY-RESULT"
      }
     ]
    },
    {
     "name": "a corrected reply can still be collected",
     "do": "reply",
     "file": "garble-reply.txt",
     "result": {
      "outcome": "completed",
      "summary": "Second try",
      "answer": "fine"
     }
    },
    {
     "name": "collect the corrected reply",
     "do": "runtime",
     "args": [
      "delegate",
      "collect",
      "--session",
      "orch",
      "--name",
      "garble-1",
      "--from",
      "{packets}/garble-reply.txt"
     ],
     "expect": [
      {
       "path": "result.status",
       "equals": "returned"
      }
     ]
    },
    {
     "name": "a worker that fails before answering is started",
     "do": "runtime",
     "args": [
      "delegate",
      "start",
      "--session",
      "orch",
      "--expect-revision",
      "{rev}",
      "--name",
      "crash-1",
      "--provider",
      "stub",
      "--mode",
      "consult",
      "--packet",
      "{packets}/consult.md",
      "--",
      "{python}",
      "{stub}",
      "{packet}",
      "--behavior",
      "crash"
     ]
    },
    {
     "name": "it exits with its error code",
     "do": "wait",
     "delegation": "crash-1",
     "expect": [
      {
       "path": "status",
       "equals": "exited"
      },
      {
       "path": "runtime.exit_code",
       "equals": 41
      }
     ]
    },
    {
     "name": "collect reports the exit code and stderr instead of accepting anything",
     "do": "runtime",
     "args": [
      "delegate",
      "collect",
      "--session",
      "orch",
      "--name",
      "crash-1"
     ],
     "expect": [
      {
       "path": "result.status",
       "equals": "malformed"
      },
      {
       "path": "result.error",
       "contains": "exit code 41"
      },
      {
       "path": "result.error",
       "contains": "Please set an Auth method"
      }
     ]
    },
    {
     "name": "cancel closes it",
     "do": "runtime",
     "args": [
      "delegate",
      "cancel",
      "--session",
      "orch",
      "--name",
      "crash-1"
     ],
     "expect": [
      {
       "path": "result.status",
       "equals": "cancelled"
      }
     ]
    },
    {
     "name": "worktree for the lying worker",
     "do": "git",
     "args": [
      "worktree",
      "add",
      "-q",
      "-b",
      "relay/lie",
      "{wt}"
     ]
    },
    {
     "name": "write packet",
     "do": "packet",
     "file": "write.md",
     "header": {
      "mode": "write",
      "name": "lie-1",
      "orchestrator": "orch",
      "phase": "P1",
      "worker_session": "worker-lie",
      "workspace": "{wt}",
      "allowed_paths": [
       "greeting.txt"
      ],
      "required_checks": {
       "unit": [
        "{python}",
        "-c",
        "pass"
       ]
      }
     },
     "body": "Create greeting.txt."
    },
    {
     "name": "a writer that skips its checks is started",
     "do": "runtime",
     "args": [
      "delegate",
      "start",
      "--session",
      "orch",
      "--expect-revision",
      "{rev}",
      "--name",
      "lie-1",
      "--provider",
      "stub",
      "--mode",
      "write",
      "--phase",
      "P1",
      "--worker-session",
      "worker-lie",
      "--workspace",
      "{wt}",
      "--packet",
      "{packets}/write.md",
      "--",
      "{python}",
      "{stub}",
      "{packet}",
      "--behavior",
      "lie",
      "--edit",
      "greeting.txt=hello",
      "--edit",
      "other.txt=surprise"
     ]
    },
    {
     "name": "it exits",
     "do": "wait",
     "delegation": "lie-1",
     "expect": [
      {
       "path": "status",
       "equals": "exited"
      }
     ]
    },
    {
     "name": "collect exposes the unrecorded checks and the unreported out-of-scope file",
     "do": "runtime",
     "args": [
      "delegate",
      "collect",
      "--session",
      "orch",
      "--name",
      "lie-1"
     ],
     "expect": [
      {
       "path": "result.status",
       "equals": "returned"
      },
      {
       "path": "result.discrepancies.0",
       "contains": "claimed to pass"
      },
      {
       "path": "result.discrepancies",
       "contains": "Required check unit"
      },
      {
       "path": "result.discrepancies",
       "contains": "Workspace changes outside the phase paths: other.txt"
      }
     ]
    },
    {
     "name": "slow writer packet (its check ignores SIGTERM)",
     "do": "packet",
     "file": "slow.md",
     "header": {
      "mode": "write",
      "name": "slow-1",
      "orchestrator": "orch",
      "phase": "P2",
      "worker_session": "worker-slow",
      "workspace": "{root}",
      "allowed_paths": [
       "slow.txt"
      ],
      "required_checks": {
       "unit": [
        "{python}",
        "-c",
        "import signal, time; signal.signal(signal.SIGTERM, signal.SIG_IGN); time.sleep(600)  # relay-golden-slow {packets}"
       ]
      }
     },
     "body": "Create slow.txt."
    },
    {
     "name": "a writer whose check outlives the relay timeout is started",
     "do": "runtime",
     "args": [
      "delegate",
      "start",
      "--session",
      "orch",
      "--expect-revision",
      "{rev}",
      "--name",
      "slow-1",
      "--provider",
      "stub",
      "--mode",
      "write",
      "--phase",
      "P2",
      "--worker-session",
      "worker-slow",
      "--packet",
      "{packets}/slow.md",
      "--timeout",
      "6",
      "--",
      "{python}",
      "{stub}",
      "{packet}",
      "--edit",
      "slow.txt=slow"
     ],
     "expect": [
      {
       "path": "ok",
       "equals": true
      }
     ]
    },
    {
     "name": "the supervisor stops it at the timeout",
     "do": "wait",
     "delegation": "slow-1",
     "timeout": 60,
     "expect": [
      {
       "path": "status",
       "equals": "exited"
      },
      {
       "path": "runtime.timed_out",
       "equals": true
      },
      {
       "path": "worker.recorded_checks.unit",
       "equals": "abandoned"
      }
     ]
    },
    {
     "name": "its check process did not survive",
     "do": "no_process",
     "pattern": "relay-golden-slow {packets}"
    },
    {
     "name": "cancel closes it and names the worker session to release",
     "do": "runtime",
     "args": [
      "delegate",
      "cancel",
      "--session",
      "orch",
      "--name",
      "slow-1"
     ],
     "expect": [
      {
       "path": "result.status",
       "equals": "cancelled"
      },
      {
       "path": "result.next",
       "contains": "worker-slow"
      }
     ]
    },
    {
     "name": "the user confirmed the worker stopped; release it",
     "do": "runtime",
     "args": [
      "release",
      "--session",
      "worker-slow",
      "--expect-revision",
      "{rev}",
      "--confirm-stopped",
      "--reason",
      "relay timeout",
      "--by",
      "orch"
     ],
     "expect": [
      {
       "path": "ok",
       "equals": true
      }
     ]
    },
    {
     "name": "review packet",
     "do": "packet",
     "file": "review.md",
     "header": {
      "mode": "review",
      "name": "late-1",
      "orchestrator": "orch",
      "workspace": "{root}"
     },
     "body": "Review."
    },
    {
     "name": "a host review is still running",
     "do": "runtime",
     "args": [
      "delegate",
      "start",
      "--session",
      "orch",
      "--name",
      "late-1",
      "--provider",
      "codex",
      "--mode",
      "review",
      "--packet",
      "{packets}/review.md",
      "--host-ref",
      "t3:task-7"
     ]
    },
    {
     "name": "ending the orchestrator reports it as open",
     "do": "runtime",
     "args": [
      "end",
      "--session",
      "orch",
      "--expect-revision",
      "{rev}",
      "--next-action",
      "collect late-1"
     ],
     "expect": [
      {
       "path": "result.open_delegations.0",
       "equals": "late-1"
      }
     ]
    },
    {
     "name": "a new orchestrator sees it on begin",
     "do": "runtime",
     "args": [
      "begin",
      "--session",
      "orch-2"
     ],
     "expect": [
      {
       "path": "result.open_delegations.0.name",
       "equals": "late-1"
      }
     ]
    },
    {
     "name": "host reply",
     "do": "reply",
     "file": "late-reply.txt",
     "result": {
      "outcome": "completed",
      "summary": "Fine",
      "verdict": "APPROVE",
      "findings": []
     }
    },
    {
     "name": "the new orchestrator adopts and collects it",
     "do": "runtime",
     "args": [
      "delegate",
      "collect",
      "--session",
      "orch-2",
      "--name",
      "late-1",
      "--from",
      "{packets}/late-reply.txt"
     ],
     "expect": [
      {
       "path": "result.status",
       "equals": "returned"
      },
      {
       "path": "result.session_id",
       "equals": "orch-2"
      },
      {
       "path": "result.adopted_from",
       "equals": "orch"
      }
     ]
    }
   ]
  }
 ]
